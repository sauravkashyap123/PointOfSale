@{
    Layout = null;
}
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POS Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
            .pos-wrap {
                min-height: 100vh;
                background: linear-gradient(150deg, #042C53 0%, #0C447C 50%, #185FA5 100%);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
                position: relative;
                overflow: hidden;
                font-family: var(--font-sans);
            }

                .pos-wrap::before {
                    content: '';
                    position: absolute;
                    top: -120px;
                    right: -120px;
                    width: 380px;
                    height: 380px;
                    border-radius: 50%;
                    border: 55px solid rgba(255,255,255,0.05);
                    pointer-events: none;
                }

                .pos-wrap::after {
                    content: '';
                    position: absolute;
                    bottom: -80px;
                    left: -80px;
                    width: 280px;
                    height: 280px;
                    border-radius: 50%;
                    border: 40px solid rgba(255,255,255,0.04);
                    pointer-events: none;
                }

            .pos-inner {
                width: 100%;
                max-width: 420px;
                position: relative;
                z-index: 1;
            }

            .status-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: rgba(255,255,255,0.1);
                border: 0.5px solid rgba(255,255,255,0.15);
                border-radius: 10px;
                padding: 8px 14px;
                margin-bottom: 1.25rem;
                backdrop-filter: blur(8px);
            }

            .status-left {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                color: rgba(255,255,255,0.85);
            }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #5DCAA5;
                box-shadow: 0 0 0 3px rgba(93,202,165,0.25);
                flex-shrink: 0;
            }

            .status-clock {
                font-size: 12px;
                color: rgba(255,255,255,0.55);
                font-variant-numeric: tabular-nums;
            }

            .card {
                background: #ffffff;
                border-radius: 20px;
                overflow: hidden;
            }

            .card-top-accent {
                height: 4px;
                background: linear-gradient(90deg, #0C447C, #378ADD, #5DCAA5);
            }

            .card-body {
                padding: 2rem 2rem 1.75rem;
            }

            .card-header {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 1.75rem;
            }

            .logo-ring {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: linear-gradient(145deg, #0C447C, #378ADD);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .logo-ring i {
                    font-size: 26px;
                    color: #fff;
                }

            .card-title {
                font-size: 20px;
                font-weight: 500;
                color: #0C447C;
                margin: 0 0 3px;
            }

            .card-sub {
                font-size: 13px;
                color: #888780;
                margin: 0;
            }

            .divider {
                border: none;
                border-top: 0.5px solid #E6F1FB;
                margin: 0 0 1.5rem;
            }

            .err-box {
                display: none;
                align-items: center;
                gap: 8px;
                background: #FCEBEB;
                border: 0.5px solid #F09595;
                border-radius: 10px;
                padding: 10px 14px;
                font-size: 13px;
                color: #A32D2D;
                margin-bottom: 1.1rem;
            }

                .err-box.show {
                    display: flex;
                }

                .err-box i {
                    font-size: 16px;
                    flex-shrink: 0;
                }

            .field-group {
                margin-bottom: 1rem;
            }

            .field-label {
                display: block;
                font-size: 11px;
                font-weight: 500;
                color: #5F5E5A;
                letter-spacing: 0.8px;
                text-transform: uppercase;
                margin-bottom: 6px;
            }

            .field-wrap {
                position: relative;
                display: flex;
                align-items: center;
            }

            .field-icon {
                position: absolute;
                left: 12px;
                font-size: 17px;
                color: #378ADD;
                pointer-events: none;
            }

            .field-input {
                width: 100%;
                height: 46px;
                border: 0.5px solid #B5D4F4;
                border-radius: 10px;
                padding: 0 42px;
                font-size: 14px;
                font-family: var(--font-sans);
                color: #0C447C;
                background: #F7FBFF;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            }

                .field-input:focus {
                    border-color: #185FA5;
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(24,95,165,0.12);
                }

                .field-input::placeholder {
                    color: #B4B2A9;
                    font-size: 13.5px;
                }

            .toggle-pw {
                position: absolute;
                right: 11px;
                background: none;
                border: none;
                cursor: pointer;
                color: #B4B2A9;
                font-size: 17px;
                display: flex;
                align-items: center;
                padding: 0;
                transition: color 0.15s;
            }

                .toggle-pw:hover {
                    color: #185FA5;
                }

            .row-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin: 0.3rem 0 1.4rem;
            }

            .remember-label {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 13px;
                color: #5F5E5A;
                cursor: pointer;
            }

                .remember-label input[type="checkbox"] {
                    accent-color: #185FA5;
                    width: 14px;
                    height: 14px;
                    cursor: pointer;
                }

            .forgot-link {
                font-size: 13px;
                color: #185FA5;
                text-decoration: none;
                font-weight: 500;
            }

                .forgot-link:hover {
                    text-decoration: underline;
                }

            .btn-login {
                width: 100%;
                height: 48px;
                background: #0C447C;
                border: none;
                border-radius: 11px;
                color: #fff;
                font-family: var(--font-sans);
                font-size: 15px;
                font-weight: 500;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                letter-spacing: 0.2px;
                transition: opacity 0.2s, transform 0.1s;
            }

                .btn-login:hover {
                    opacity: 0.88;
                }

                .btn-login:active {
                    transform: scale(0.98);
                }

                .btn-login:disabled {
                    opacity: 0.6;
                    cursor: not-allowed;
                }

                .btn-login i {
                    font-size: 18px;
                }

            .card-footer-divider {
                border: none;
                border-top: 0.5px solid #E6F1FB;
                margin: 1.5rem 0 0;
            }

            .admin-strip {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1rem 2rem;
                background: #F7FBFF;
                border-top: 0.5px solid #E6F1FB;
            }

            .admin-strip-left {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                color: #5F5E5A;
            }

                .admin-strip-left i {
                    font-size: 16px;
                    color: #378ADD;
                }

            .admin-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 13px;
                font-weight: 500;
                color: #185FA5;
                text-decoration: none;
                padding: 5px 12px;
                border: 0.5px solid #B5D4F4;
                border-radius: 8px;
                background: #fff;
                transition: background 0.15s, border-color 0.15s;
            }

                .admin-link:hover {
                    background: #E6F1FB;
                    border-color: #185FA5;
                }

                .admin-link i {
                    font-size: 14px;
                }

            .secure-strip {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 16px;
                padding: 0.85rem 2rem;
                border-top: 0.5px solid #E6F1FB;
            }

            .secure-item {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 11.5px;
                color: #B4B2A9;
            }

                .secure-item i {
                    font-size: 13px;
                    color: #378ADD;
                }

            .version-tag {
                margin-top: 1.1rem;
                font-size: 11px;
                color: rgba(255,255,255,0.35);
                letter-spacing: 0.4px;
                text-align: center;
            }
    </style>
</head>
<body>
    <div class="pos-wrap">
        <div class="pos-inner">

            <div class="status-bar">
                <div class="status-left">
                    <div class="status-dot"></div>
                    System Online
                </div>
                <span class="status-clock" id="pClock">--:-- --</span>
            </div>

            <div class="card">
                <div class="card-top-accent"></div>
                <div class="card-body">

                    <div class="card-header">
                        <div class="logo-ring">
                            <img src="~/images/srisaisweets.jpg" style="height: 57px;" />
                            
                        </div>
                        <div>
                            <p class="card-title">Point of Sale</p>
                            <p class="card-sub">Enter your credentials to sign in</p>
                        </div>
                    </div>

                    <hr class="divider">

                    <div class="err-box" id="errBox" role="alert">
                        <i class="ti ti-alert-circle" aria-hidden="true"></i>
                        <span id="errText">Invalid User ID or Password.</span>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="pUserId">User ID</label>
                        <div class="field-wrap">
                            <i class="ti ti-id-badge-2 field-icon" aria-hidden="true"></i>
                            <input class="field-input" type="text" id="pUserId" placeholder="Enter your User ID" autocomplete="username" />
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="pPassword">Password</label>
                        <div class="field-wrap">
                            <i class="ti ti-lock field-icon" aria-hidden="true"></i>
                            <input class="field-input" type="password" id="pPassword" placeholder="Enter your password" autocomplete="current-password" />
                            <button class="toggle-pw" id="pTogglePw" type="button" aria-label="Toggle password visibility">
                                <i class="ti ti-eye" id="pEyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row-options">
                        <label class="remember-label">
                            <input type="checkbox" id="pRemember"> Remember me
                        </label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button class="btn-login" id="pLoginBtn" type="button">
                        <i class="ti ti-login" aria-hidden="true"></i> Sign in
                    </button>

                </div>

                <div class="admin-strip">
                    <div class="admin-strip-left">
                        <i class="ti ti-shield-lock" aria-hidden="true"></i>
                        Admin access
                    </div>
                    <a href="/Account/Login" class="admin-link">
                        <i class="ti ti-arrow-right" aria-hidden="true"></i>
                        Go to Admin Login
                    </a>
                </div>

                <div class="secure-strip">
                    <div class="secure-item">
                        <i class="ti ti-shield-check" aria-hidden="true"></i>
                        256-bit encryption
                    </div>
                    <div class="secure-item">
                        <i class="ti ti-eye-off" aria-hidden="true"></i>
                        Access monitored
                    </div>
                    <div class="secure-item">
                        <i class="ti ti-user-check" aria-hidden="true"></i>
                        Authorized only
                    </div>
                </div>
            </div>

            <p class="version-tag">POS v2.5.1 &nbsp;&bull;&nbsp; &copy; 2025 Your Company</p>
        </div>
    </div>

    <script>
            function updateClock() {
              const now = new Date();
              let h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
              const ampm = h >= 12 ? 'PM' : 'AM';
              h = h % 12 || 12;
              document.getElementById('pClock').textContent =
                h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0') + ' ' + ampm;
            }
            setInterval(updateClock, 1000);
            updateClock();

            document.getElementById('pTogglePw').addEventListener('click', function() {
              const inp = document.getElementById('pPassword');
              const icon = document.getElementById('pEyeIcon');
              if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'ti ti-eye-off';
              } else {
                inp.type = 'password';
                icon.className = 'ti ti-eye';
              }
            });

            function handleLogin() {
              const uid = document.getElementById('pUserId').value.trim();
              const pw = document.getElementById('pPassword').value.trim();
              const errBox = document.getElementById('errBox');
              const errText = document.getElementById('errText');
              const btn = document.getElementById('pLoginBtn');

              errBox.classList.remove('show');

              if (!uid || !pw) {
                errText.textContent = 'User ID and Password are required.';
                errBox.classList.add('show');
                return;
              }

              btn.disabled = true;
              btn.innerHTML = '<i class="ti ti-loader" style="animation:spin 1s linear infinite"></i>&nbsp; Signing in...';

              fetch('/POS/Login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Mobileno: uid, Password: pw })
              })
              .then(r => r.json())
              .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="ti ti-login"></i> Sign in';
                if (data.result === true) {
                  window.location.href = data.redirect;
                } else {
                  errText.textContent = data.message || 'Login failed. Please try again.';
                  errBox.classList.add('show');
                }
              })
              .catch(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="ti ti-login"></i> Sign in';
                errText.textContent = 'Server error. Please try again.';
                errBox.classList.add('show');
              });
            }

            document.getElementById('pLoginBtn').addEventListener('click', handleLogin);
            document.getElementById('pPassword').addEventListener('keydown', function(e) {
              if (e.key === 'Enter') handleLogin();
            });
            document.getElementById('pUserId').addEventListener('keydown', function(e) {
              if (e.key === 'Enter') document.getElementById('pPassword').focus();
            });
    </script>
</body>

</html>

