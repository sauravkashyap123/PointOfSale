                <div class="color-dot"
                     style="background:#1c1500"
                     data-bg="#1c1500" data-accent="#d97706" data-alight="#fbbf24"
                     title="Dark Amber" onclick="setColor(this)"></div>
                <div class="color-dot"
                     style="background:#f1f5f9; border: 1px solid #cbd5e1;"
                     data-bg="#f1f5f9" data-accent="#7c3aed" data-alight="#6d28d9"
                     data-text="#1e1b4b" data-muted="#64748b" data-border="rgba(0,0,0,0.08)"
