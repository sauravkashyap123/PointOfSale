    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        let isCollapsed = false;

        /* ---- Desktop: collapse / expand ---- */
        function toggleCollapse() {
          isCollapsed = !isCollapsed;
          document.getElementById('sidebar').classList.toggle('collapsed', isCollapsed);
        }

        /* ---- Mobile: open / close drawer ---- */
        function openMobile() {
          document.getElementById('sidebar').classList.add('mobile-open');
          document.getElementById('overlay').classList.add('show');
        }
        function closeMobile() {
          document.getElementById('sidebar').classList.remove('mobile-open');
          document.getElementById('overlay').classList.remove('show');
        }

        /* ---- Dropdown toggle ---- */
        function toggleDropdown(id) {
          const body   = document.getElementById(id);
          const toggle = document.getElementById(id + '-toggle');
          const isOpen = body.classList.contains('open');

          // Close all
          document.querySelectorAll('.dropdown-body').forEach(b => b.classList.remove('open'));
          document.querySelectorAll('.dropdown-toggle').forEach(t => t.classList.remove('open'));

          // Open clicked one if it was closed
          if (!isOpen) {
            body.classList.add('open');
            toggle.classList.add('open');
          }
        }

        /* ---- Active state ---- */
        function setActive(el) {
          document.querySelectorAll('.nav-item:not(.dropdown-toggle), .sub-item')
                  .forEach(i => i.classList.remove('active'));
          el.classList.add('active');
        }

        /* ---- Color theme switcher ---- */
        function setColor(dot) {
          document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
          dot.classList.add('active');

          const sb = document.getElementById('sidebar');
          sb.style.setProperty('--sb-bg',     dot.dataset.bg);
          sb.style.setProperty('--sb-accent', dot.dataset.accent);
          sb.style.setProperty('--sb-accent-lt', dot.dataset.alight || dot.dataset.accent);
          sb.style.setProperty('--sb-text',   dot.dataset.text   || '#e2e8f0');
          sb.style.setProperty('--sb-muted',  dot.dataset.muted  || '#94a3b8');
          sb.style.setProperty('--sb-border', dot.dataset.border || 'rgba(255,255,255,0.07)');
          sb.style.setProperty('--sb-hover',  dot.dataset.hover  || 'rgba(124,58,237,0.15)');

          // Update badge colors
          document.querySelectorAll('.nav-badge').forEach(b => b.style.background = dot.dataset.accent);
        }
    </script>
    @RenderSection("Scripts", required: false)

</body>
