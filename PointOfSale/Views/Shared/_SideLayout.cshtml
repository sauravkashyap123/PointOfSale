                     title="Dark Purple" onclick="setColor(this)"></div>
                <div class="color-dot"
                     style="background:#0f1f38"
                     data-bg="#0f1f38" data-accent="#2563eb" data-alight="#60a5fa"
                     title="Dark Blue" onclick="setColor(this)"></div>
                <div class="color-dot"
                     style="background:#0d2416"
                     data-bg="#0d2416" data-accent="#16a34a" data-alight="#4ade80"
                     title="Dark Green" onclick="setColor(this)"></div>
                <div class="color-dot"
                     style="background:#1a1212"
                     data-bg="#1a1212" data-accent="#dc2626" data-alight="#f87171"
