@model List<POSModels.Models.ShopSettingModel>

@{
    ViewData["Title"] = "Store Settings List";
    Layout = "~/Views/Shared/_SideLayout.cshtml";
}

<style>
    .container-custom {
        max-width: 1400px;
        margin: 25px auto;
    }

    .custom-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .custom-header {
        background: linear-gradient(135deg,#0d6efd,#0b5ed7);
        color: #fff;
        padding: 18px 25px;
    }

        .custom-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

    .custom-body {
        padding: 20px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .custom-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .custom-table thead th {
            background: #1f2937;
            color: #fff;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: .5px;
            padding: 14px;
            text-align: center;
            border: 1px solid #dee2e6;
            white-space: nowrap;
        }

        .custom-table tbody td {
            padding: 12px;
            border: 1px solid #e5e7eb;
            vertical-align: middle;
        }

        .custom-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        .custom-table tbody tr:hover {
            background: #edf4ff;
            transition: .2s;
        }

    .btn-edit {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        text-decoration: none;
        display: inline-block;
        font-size: 13px;
        font-weight: 500;
    }

        .btn-edit:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-delete {
        background: linear-gradient(135deg,#dc2626,#b91c1c);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        text-decoration: none;
        display: inline-block;
        font-size: 13px;
        font-weight: 500;
    }

        .btn-delete:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .badge-count {
        background: rgba(255,255,255,.2);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        margin-left: 10px;
    }

    .no-record {
        text-align: center;
        color: #dc3545;
        font-weight: 600;
        padding: 20px;
    }
</style>

<div class="container-custom">

    <div class="custom-card">

        <div class="custom-header">
            <h4>
                Store Settings List
                <span class="badge-count">
                    Total Records : @(Model?.Count ?? 0)
                </span>
            </h4>
        </div>

        <div class="custom-body">

            <div class="mb-3 text-end">
                <a href="@Url.Action("PrintBilllData", "Billing")"
                   class="btn btn-success">
                    + Add New Store
                </a>
            </div>

            <div class="table-responsive">

                <table class="custom-table">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Store Name</th>
                            <th>GST Number</th>
                            <th>Mobile No</th>
                            <th>Address</th>
                            <th>Shop Name</th>
                            <th width="180">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@sr</td>

                                    <td>@item.StoreName</td>

                                    <td>@item.GSTNumber</td>

                                    <td>@item.MobileNo</td>

                                    <td>@item.Address</td>

                                    <td>@item.ShopName</td>

                                    <td class="text-center">

                                        <a href="@Url.Action("PrintBilllData", "Billing", new { id = item.Id })"
                                           class="btn-edit">
                                            Edit
                                        </a>

                                        <a href="@Url.Action("DeletePrintData", "Billing", new { id = item.Id })"
                                           class="btn-delete"
                                           onclick="return confirm('Are you sure you want to delete this record?')">
                                            Delete
                                        </a>

                                    </td>
                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-record">
                                    No Record Found
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>