@{
    ViewData["Title"] = "Stock List";
    Layout = "~/Views/Shared/_SideLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* Stats */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 1.25rem;
    }

    .stat-card {
        background: var(--surface-2, #fff);
        border: 0.5px solid var(--border, #e5e7eb);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #E6F1FB;
            color: #0C447C;
        }

        .stat-icon.green {
            background: #EAF3DE;
            color: #3B6D11;
        }

        .stat-icon.amber {
            background: #FAEEDA;
            color: #854F0B;
        }

        .stat-icon.red {
            background: #FCEBEB;
            color: #A32D2D;
        }

    .stat-info .val {
        font-size: 22px;
        font-weight: 500;
        color: #111;
        line-height: 1.2;
    }

    .stat-info .lbl {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 2px;
    }

    /* Main Card */
    .card {
        background: #fff;
        border: 0.5px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 0.5px solid #e5e7eb;
    }

        .card-header h4 {
            font-size: 16px;
            font-weight: 500;
            color: #111;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .badge-count {
        background: #E6F1FB;
        color: #0C447C;
        font-size: 12px;
        font-weight: 500;
        padding: 4px 10px;
        border-radius: 20px;
    }

    /* Toolbar */
    .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 1rem 1.25rem;
        border-bottom: 0.5px solid #e5e7eb;
        align-items: center;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f9fafb;
        border: 0.5px solid #d1d5db;
        border-radius: 8px;
        padding: 0 12px;
        flex: 1;
        min-width: 200px;
    }

        .search-box i {
            color: #9ca3af;
            font-size: 14px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 14px;
            color: #111;
            padding: 8px 0;
            width: 100%;
        }

            .search-box input::placeholder {
                color: #9ca3af;
            }

    .cat-filter {
        background: #f9fafb;
        border: 0.5px solid #d1d5db;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        color: #374151;
        outline: none;
        cursor: pointer;
    }

    .sort-group {
        display: flex;
        gap: 6px;
    }

    .sort-btn {
        background: #f9fafb;
        border: 0.5px solid #d1d5db;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        color: #6b7280;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all .15s;
    }

        .sort-btn:hover {
            background: #f3f4f6;
            color: #111;
        }

        .sort-btn.active {
            background: #E6F1FB;
            border-color: #B5D4F4;
            color: #0C447C;
        }

    /* Table */
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    thead tr {
        background: #f9fafb;
    }

    thead th {
        padding: 10px 14px;
        text-align: left;
        font-size: 12px;
        font-weight: 500;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 0.5px solid #e5e7eb;
    }

    tbody tr {
        border-bottom: 0.5px solid #e5e7eb;
        transition: background .1s;
    }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #f9fafb;
        }

        tbody tr.low-stock-row {
            background: #FAEEDA33;
        }

        tbody tr.critical-row {
            background: #FCEBEB33;
        }

    tbody td {
        padding: 10px 14px;
        color: #111;
        vertical-align: middle;
    }

    /* Chips & Badges */
    .code-chip {
        background: #f3f4f6;
        border: 0.5px solid #d1d5db;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 12px;
        font-family: monospace;
        color: #4b5563;
    }

    .cat-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        background: #E6F1FB;
        color: #0C447C;
    }

    .qty-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .qty-ok {
        background: #EAF3DE;
        color: #27500A;
    }

    .qty-low {
        background: #FAEEDA;
        color: #633806;
    }

    .qty-critical {
        background: #FCEBEB;
        color: #791F1F;
    }

    .warn-tag {
        font-size: 10px;
        font-weight: 500;
        padding: 2px 7px;
        border-radius: 20px;
        margin-left: 6px;
        vertical-align: middle;
    }

    .warn-low {
        background: #FAEEDA;
        color: #854F0B;
    }

    .warn-critical {
        background: #FCEBEB;
        color: #A32D2D;
    }

    /* History Button */
    .btn-history {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: transparent;
        border: 0.5px solid #d1d5db;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 12px;
        color: #6b7280;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-history:hover {
            background: #E6F1FB;
            border-color: #B5D4F4;
            color: #0C447C;
        }

    /* Footer / Pagination */
    .dt-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .75rem 1.25rem;
        border-top: 0.5px solid #e5e7eb;
    }

    .dt-info-text {
        font-size: 13px;
        color: #9ca3af;
    }

    .pg-btns {
        display: flex;
        gap: 4px;
    }

    .pg-btn {
        min-width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 0.5px solid #e5e7eb;
        font-size: 13px;
        color: #6b7280;
        cursor: pointer;
        padding: 0 8px;
        transition: all .15s;
    }

        .pg-btn:hover:not(.disabled):not(.active) {
            background: #f3f4f6;
            color: #111;
        }

        .pg-btn.active {
            background: #0C447C;
            border-color: #0C447C;
            color: #fff;
        }

        .pg-btn.disabled {
            opacity: .4;
            cursor: default;
        }

    /* No Data */
    .no-data-row td {
        text-align: center;
        padding: 2.5rem;
        color: #9ca3af;
    }
</style>

<div class="container mt-3" style="margin-left:10px;">

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div class="stat-info">
                <div class="val" id="statTotal">0</div>
                <div class="lbl">Total Products</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-cubes"></i></div>
            <div class="stat-info">
                <div class="val" id="statQty">0</div>
                <div class="lbl">Total Quantity</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-info">
                <div class="val" id="statLow">0</div>
                <div class="lbl">Low Stock</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red"><i class="fa-solid fa-circle-exclamation"></i></div>
            <div class="stat-info">
                <div class="val" id="statCritical">0</div>
                <div class="lbl">Critical Stock</div>
            </div>
        </div>
    </div>

    <!-- Main Card -->
    <div class="card">
        <div class="card-header">
            <h4><i class="fa-solid fa-warehouse me-2"></i> Stock List</h4>
            <span class="badge-count" id="headCount">0 products</span>
        </div>

        <!-- Toolbar -->
        <div class="toolbar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="liveSearch" placeholder="Search product, code, category…" />
            </div>
            <select class="cat-filter" id="catFilter">
                <option value="">All Categories</option>
            </select>
            <div class="sort-group">
                <button class="sort-btn" id="sortName" onclick="toggleSort('productName')">
                    <i class="fa-solid fa-arrow-down-a-z"></i> Name
                </button>
                <button class="sort-btn" id="sortQty" onclick="toggleSort('quantity')">
                    <i class="fa-solid fa-arrow-down-9-1"></i> Qty
                </button>
            </div>
        </div>

        <!-- Table -->
        <div style="overflow-x:auto; width:100%;">
            <table id="stockTable" class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product Name</th>
                        <th>Product Code</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Quantity</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="stockBody"></tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="dt-footer">
            <span class="dt-info-text" id="dtInfo"></span>
            <div class="pg-btns" id="pgBtns"></div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    let allData = [], filtered = [];
    let sortKey = '', sortDir = 1;
    let currentPage = 1;
    const PAGE_SIZE = 10;

    // ── Fetch ──
    $.getJSON('/Billing/AllStockList', function (res) {
        allData = res.data || [];
        initCategoryFilter();
        applyFilters();
    });

    function initCategoryFilter() {
        const cats = [...new Set(allData.map(r => r.categoryName))].sort();
        const sel = document.getElementById('catFilter');
        cats.forEach(c => {
            const o = document.createElement('option');
            o.value = c; o.textContent = c;
            sel.appendChild(o);
        });
    }

    document.getElementById('liveSearch').addEventListener('input', applyFilters);
    document.getElementById('catFilter').addEventListener('change', applyFilters);

    // ── Filter ──
    function applyFilters() {
        const q   = document.getElementById('liveSearch').value.toLowerCase();
        const cat = document.getElementById('catFilter').value;

        filtered = allData.filter(r => {
            const matchQ = !q ||
                r.productName.toLowerCase().includes(q) ||
                r.productCode.toLowerCase().includes(q) ||
                r.categoryName.toLowerCase().includes(q);
            const matchC = !cat || r.categoryName === cat;
            return matchQ && matchC;
        });

        if (sortKey) doSort();
        currentPage = 1;
        updateStats();
        renderTable();
    }

    // ── Sort ──
    function toggleSort(key) {
        if (sortKey === key) sortDir *= -1;
        else { sortKey = key; sortDir = 1; }

        document.getElementById('sortName').classList.toggle('active', key === 'productName');
        document.getElementById('sortQty').classList.toggle('active', key === 'quantity');

        doSort();
        currentPage = 1;
        renderTable();
    }

    function doSort() {
        filtered.sort((a, b) => {
            const av = typeof a[sortKey] === 'number' ? a[sortKey] : a[sortKey].toLowerCase();
            const bv = typeof b[sortKey] === 'number' ? b[sortKey] : b[sortKey].toLowerCase();
            return av > bv ? sortDir : av < bv ? -sortDir : 0;
        });
    }

    // ── Stats ──
    function updateStats() {
        document.getElementById('statTotal').textContent    = filtered.length;
        document.getElementById('statQty').textContent      = filtered.reduce((s, r) => s + r.quantity, 0).toLocaleString();
        document.getElementById('statLow').textContent      = filtered.filter(r => r.quantity > 5 && r.quantity <= 20).length;
        document.getElementById('statCritical').textContent = filtered.filter(r => r.quantity <= 5).length;
        document.getElementById('headCount').textContent    = filtered.length + ' products';
    }

    // ── Helpers ──
    function qtyBadge(q) {
        if (q <= 5)  return `<span class="qty-badge qty-critical"><i class="fa-solid fa-circle-exclamation"></i> ${parseFloat(q).toFixed(2)}</span>`;
        if (q <= 20) return `<span class="qty-badge qty-low"><i class="fa-solid fa-triangle-exclamation"></i> ${parseFloat(q).toFixed(2)}</span>`;
        return `<span class="qty-badge qty-ok">${parseFloat(q).toFixed(2)}</span>`;
    }

    function catBadge(c) {
        return `<span class="cat-badge cat-${c.replace(/\s/g, '')}">${c}</span>`;
    }

    function warnTag(q) {
        if (q <= 5)  return `<span class="warn-tag warn-critical">Critical</span>`;
        if (q <= 20) return `<span class="warn-tag warn-low">Low</span>`;
        return '';
    }

    function rowClass(q) {
        if (q <= 5)  return 'critical-row';
        if (q <= 20) return 'low-stock-row';
        return '';
    }

    // ── Action Button ──
    function actionBtn(id, name) {
        const safeName = encodeURIComponent(name);
        return `<button class="btn-history"
                    onclick="window.location.href='/Billing/ViewStockHistory?stockid=${id}'"
                    title="View Stock History">
                    <i class="fa-solid fa-eye"></i>
                    <span>History</span>
                </button>`;
    }

    // ── Render Table ──
    function renderTable() {
        const start = (currentPage - 1) * PAGE_SIZE;
        const slice = filtered.slice(start, start + PAGE_SIZE);
        const body  = document.getElementById('stockBody');

        if (!filtered.length) {
            body.innerHTML = `<tr class="no-data-row">
                <td colspan="6">
                    <i class="fa-solid fa-box-open" style="font-size:28px;display:block;margin-bottom:10px;color:#d1d5db"></i>
                    No products found
                </td>
            </tr>`;
        } else {
            body.innerHTML = slice.map((r, i) => `
                <tr class="${rowClass(r.quantity)} ">
                    <td>${start + i + 1}</td>
                    <td><strong>${r.productName}</strong>${warnTag(r.quantity)}</td>
                    <td><span class="code-chip">${r.productCode}</span></td>
                    <td>${catBadge(r.categoryName)}</td>
                    <td>${catBadge(r.shortName)}</td>
                    <td>${qtyBadge(r.quantity)}</td>
                    <td>${actionBtn(r.id, r.productName)}</td>
                </tr>`).join('');
        }

        renderPagination();
    }

    // ── Pagination ──
    function renderPagination() {
        const total = filtered.length;
        const pages = Math.ceil(total / PAGE_SIZE);
        const start = (currentPage - 1) * PAGE_SIZE;

        document.getElementById('dtInfo').textContent = total
            ? `Showing ${start + 1}–${Math.min(start + PAGE_SIZE, total)} of ${total} entries`
            : '';

        const pg = document.getElementById('pgBtns');
        pg.innerHTML = '';

        // Prev
        const prev = document.createElement('span');
        prev.className = 'pg-btn' + (currentPage === 1 ? ' disabled' : '');
        prev.innerHTML = '<i class="fa-solid fa-chevron-left" style="font-size:11px"></i>';
        prev.onclick = () => { if (currentPage > 1) { currentPage--; renderTable(); } };
        pg.appendChild(prev);

        // Page numbers with ellipsis
        for (let p = 1; p <= pages; p++) {
            if (pages > 7 && p !== 1 && p !== pages && (p < currentPage - 1 || p > currentPage + 1)) {
                if (p === currentPage - 2 || p === currentPage + 2) {
                    const dots = document.createElement('span');
                    dots.className = 'pg-btn disabled';
                    dots.textContent = '…';
                    pg.appendChild(dots);
                }
                continue;
            }
            const btn = document.createElement('span');
            btn.className = 'pg-btn' + (p === currentPage ? ' active' : '');
            btn.textContent = p;
            btn.onclick = (pp => () => { currentPage = pp; renderTable(); })(p);
            pg.appendChild(btn);
        }

        // Next
        const next = document.createElement('span');
        next.className = 'pg-btn' + (currentPage === pages || pages === 0 ? ' disabled' : '');
        next.innerHTML = '<i class="fa-solid fa-chevron-right" style="font-size:11px"></i>';
        next.onclick = () => { if (currentPage < pages) { currentPage++; renderTable(); } };
        pg.appendChild(next);
    }
</script>