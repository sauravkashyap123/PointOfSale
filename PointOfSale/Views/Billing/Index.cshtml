  <div class="cat-pill" onclick="selectCat(this,'toys')"><i class="ti ti-puzzle"></i> Kids Toys</div>  *@
</div>

<!-- ═══ BODY ═══ -->
<div class="body-row">

  <!-- PRODUCT AREA 70% -->
  <div class="product-area">
    <div class="product-grid" id="productGrid"></div>
  </div>

  <!-- ORDER SIDEBAR 30% -->
  <div class="order-sidebar" id="orderSidebar">
    <div class="order-header">
      <div class="order-title">
        <i class="ti ti-receipt-2"></i> Order
        <span class="order-count" id="orderCount">0</span>
      </div>
      <button class="clear-btn" onclick="clearOrder()">
        <i class="ti ti-trash"></i> Clear
      </button>
    </div>

    <div class="order-items" id="orderItems">
      <div class="empty-order" id="emptyOrder">
        <i class="ti ti-shopping-cart-plus"></i>
        <p>No items added yet</p>
        <small>Click a product to add</small>
      </div>
    </div>

    <div class="order-totals">
      <div class="tot-row">
        <span class="lbl"><i class="ti ti-receipt"></i> Subtotal</span>
        <span class="val" id="subtotalVal">Rs0.00</span>
      </div>
      <div class="disc-row">
        <span class="disc-lbl"><i class="ti ti-discount-2"></i> Discount</span>
        <div class="disc-right">
          <input class="disc-input" type="number" id="discountVal" value="0" min="0" oninput="recalc()">
          <div class="disc-type">
            <button id="discPct" class="active" onclick="setDiscType('pct')">%</button>
            <button id="discFlat" onclick="setDiscType('flat')">Rs</button>
          </div>
          <span class="disc-saved" id="discSaved"></span>
        </div>
      </div>
      <div class="tot-row">
        <span class="lbl"><i class="ti ti-file-invoice"></i> Tax (0%)</span>
        <span class="val">Rs0.00</span>
      </div>
      <hr class="tot-divider">
      <div class="grand-row">
        <span class="grand-lbl"><i class="ti ti-circle-check"></i> Total</span>
        <span class="grand-val" id="grandTotal">Rs0.00</span>
      </div>
    </div>

    <div class="pay-section">
      <button class="pay-btn" onclick="openBill()">
        <i class="ti ti-credit-card"></i>
        Pay Bill &nbsp;<span id="payAmt">Rs0.00</span>
      </button>
    </div>
  </div>
</div>

<!-- ═══ MOBILE CART BUTTON ═══ -->
<button class="mob-cart-btn" id="mobCartBtn" onclick="openCartDrawer()" title="View Order">
  <i class="ti ti-shopping-cart"></i>
  <span class="mob-cart-count" id="mobCartCount">0</span>
</button>

<!-- ═══ MOBILE CART DRAWER ═══ -->
<div class="cart-overlay" id="cartOverlay" onclick="closeCartDrawer()"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="drawer-handle"></div>
  <div class="order-header" style="padding:8px 14px">
    <div class="order-title">
      <i class="ti ti-receipt-2"></i> Order
      <span class="order-count" id="orderCountMob">0</span>
    </div>
    <div style="display:flex;gap:8px">
      <button class="clear-btn" onclick="clearOrder()"><i class="ti ti-trash"></i> Clear</button>
      <button class="clear-btn" onclick="closeCartDrawer()"><i class="ti ti-x"></i></button>
    </div>
  </div>
  <div class="order-items" id="orderItemsMob" style="max-height:40vh"></div>
  <div class="order-totals" id="orderTotalsMob">
    <div class="tot-row">
      <span class="lbl"><i class="ti ti-receipt"></i> Subtotal</span>
      <span class="val" id="subtotalMob">Rs0.00</span>
    </div>
    <hr class="tot-divider">
    <div class="grand-row">
      <span class="grand-lbl"><i class="ti ti-circle-check"></i> Total</span>
      <span class="grand-val" id="grandMob">Rs0.00</span>
    </div>
  </div>
  <div class="pay-section">
    <button class="pay-btn" onclick="openBill()">
      <i class="ti ti-credit-card"></i>
      Pay Bill &nbsp;<span id="payAmtMob">Rs0.00</span>
    </button>
  </div>
</div>

<!-- ═══ BILL MODAL ═══ -->
<div class="modal-overlay" id="billModal" style="display:none" onclick="closeBillOutside(event)">
  <div class="bill-modal">
    <div class="bill-print" id="billPrint">
      <div class="bill-top">
        <div class="bill-logo">@(ViewBag.ShopName ?? "Sri Sai Sweets")</div>
        <div class="bill-store">@(ViewBag.Address ?? "Main Road, Jamshedpur")</div>
        <div class="bill-store">Tel: @(ViewBag.Mobileno ?? "+91 0000000000")@(!string.IsNullOrEmpty(ViewBag.Gstnumber) ? " · GSTIN: " + ViewBag.Gstnumber : "")</div>
        <div class="bill-meta" id="billMeta"></div>
      </div>
      <div class="bill-items-head">
        <span class="bh-item">Item</span>
        <span class="bh-qty">Qty</span>
        <span class="bh-amt">Amount</span>
      </div>
      <div id="billItemsBody"></div>
      <div class="bill-tots" id="billTots"></div>
      <div class="bill-footer">
        <div>🙏 Thank you for shopping with us!</div>
        <div>Please visit again</div>
        <div style="margin-top:6px;font-size:9px">Powered by ShopFlow POS</div>
      </div>
    </div>
    <div class="bill-actions">
      <button class="btn-close-bill" onclick="closeBill()"><i class="ti ti-x"></i> Close</button>
      <button class="btn-print-bill" onclick="printBill()"><i class="ti ti-printer"></i> Print Bill</button>
    </div>
  </div>
</div>

<!-- ═══ BULK ORDER MODAL ═══ -->
<div class="modal-overlay" id="bulkOrderModal" style="display:none" onclick="closeBulkOrderOutside(event)">
  <div class="bill-modal" style="width: 420px; padding: 20px; background: #fff; border-radius: 16px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid var(--border); padding-bottom:10px;">
      <h3 style="font-size:16px; font-weight:700; color:var(--dark); display:flex; align-items:center; gap:6px;"><i class="ti ti-truck-delivery" style="color:var(--or); font-size:20px;"></i>Create Bulk Order</h3>
      <button onclick="closeBulkOrderModal()" style="background:none; border:none; font-size:20px; cursor:pointer; color:var(--muted);">&times;</button>
    </div>
    
    <div style="display:flex; flex-direction:column; gap:12px;">
      <div style="display:flex; flex-direction:column; gap:4px;">
        <label style="font-size:12px; font-weight:600; color:var(--text);">Customer Name <span style="color:var(--red)">*</span></label>
        <input type="text" id="boCustomerName" placeholder="e.g. Rakesh Sharma" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; outline:none;" />
      </div>
      
      <div style="display:flex; flex-direction:column; gap:4px;">
        <label style="font-size:12px; font-weight:600; color:var(--text);">Customer Contact <span style="color:var(--red)">*</span></label>
        <input type="text" id="boContactNumber" placeholder="e.g. 9876543210" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; outline:none;" />
      </div>

      <div style="display:flex; flex-direction:column; gap:4px;">
        <label style="font-size:12px; font-weight:600; color:var(--text);">Delivery Date &amp; Time <span style="color:var(--red)">*</span></label>
        <input type="datetime-local" id="boDeliveryDate" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; outline:none;" />
      </div>

      <div style="display:flex; gap:12px;">
        <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
          <label style="font-size:12px; font-weight:600; color:var(--text);">Total Amount (Rs)</label>
          <input type="text" id="boTotalAmount" readonly style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; background:#f8fafc; font-weight:700; color:var(--or2); text-align:center;" />
        </div>
        <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
          <label style="font-size:12px; font-weight:600; color:var(--text);">Advance Paid <span style="color:var(--red)">*</span></label>
          <input type="number" id="boAdvanceAmount" min="0" placeholder="e.g. 500" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; text-align:center; outline:none;" />
        </div>
      </div>

      <div style="display:flex; flex-direction:column; gap:4px;">
        <label style="font-size:12px; font-weight:600; color:var(--text);">Remarks / Event Details</label>
        <textarea id="boRemarks" placeholder="Optional - wedding party, custom packaging requests..." style="width:100%; height:60px; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; resize:none; outline:none; font-family:var(--font);"></textarea>
      </div>
    </div>

    <div style="display:flex; gap:10px; margin-top:20px; border-top:1px solid var(--border); padding-top:15px;">
      <button onclick="closeBulkOrderModal()" style="flex:1; padding:10px; border-radius:8px; border:1.5px solid var(--border); background:none; cursor:pointer; font-size:13px; font-weight:600; color:var(--muted);">Cancel</button>
      <button onclick="submitBulkOrder()" style="flex:1; padding:10px; border-radius:8px; border:none; background:var(--or); color:#fff; cursor:pointer; font-size:13px; font-weight:600;">Save Bulk Order</button>
    </div>
  </div>
</div>
 
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/product1.js"></script>

</body>
</html>
