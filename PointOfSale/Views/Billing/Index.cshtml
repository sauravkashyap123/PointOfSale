  <div class="cat-pill" onclick="selectCat(this,'mithai')"><i class="ti ti-cake"></i> Mithai</div>
  <div class="cat-pill" onclick="selectCat(this,'snacks')"><i class="ti ti-bowl"></i> Snacks</div>
  <div class="cat-pill" onclick="selectCat(this,'drinks')"><i class="ti ti-bottle"></i> Drinks</div>
  <div class="cat-pill" onclick="selectCat(this,'cameras')"><i class="ti ti-camera"></i> Cameras</div>
  <div class="cat-pill" onclick="selectCat(this,'computers')"><i class="ti ti-device-laptop"></i> Computers</div>
  <div class="cat-pill" onclick="selectCat(this,'gaming')"><i class="ti ti-device-gamepad-2"></i> Gaming</div>
  <div class="cat-pill" onclick="selectCat(this,'headphones')"><i class="ti ti-headphones"></i> Headphones</div>
  <div class="cat-pill" onclick="selectCat(this,'mobile')"><i class="ti ti-device-mobile"></i> Mobile</div>
  <div class="cat-pill" onclick="selectCat(this,'furniture')"><i class="ti ti-armchair"></i> Furniture</div>
  <div class="cat-pill" onclick="selectCat(this,'speakers')"><i class="ti ti-speakerphone"></i> Speakers</div>
