@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sri Sai Sweet — Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css">
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            :root {
                --blue-dark: #0E1F4A;
                --blue-mid: #152960;
                --blue-card: #1A3370;
                --blue-accent: #1B4FBF;
                --blue-light: #1E6FD9;
                --blue-glow: rgba(30,111,217,0.3);
                --teal: #00C9A7;
                --orange: #F97316;
                --white: #FFFFFF;
                --text: #1E293B;
                --text2: #64748B;
                --border: #E2E8F0;
                --input-bg: #F8FAFC;
                --font: 'Inter',sans-serif;
                --mono: 'JetBrains Mono',monospace;
            }

            html, body {
                height: 100%;
                overflow: hidden
            }

            body {
                font-family: var(--font);
                background: linear-gradient(145deg,#0B1D4A 0%,#0E2257 40%,#132B6E 70%,#0E1F4A 100%);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                position: relative;
            }

            /* ── BG CIRCLES ── */
            .bg-wrap {
                position: fixed;
                inset: 0;
                overflow: hidden;
                pointer-events: none;
                z-index: 0
            }

            .bg-circle {
                position: absolute;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.06)
            }

            .bc1 {
                width: 600px;
                height: 600px;
                top: -180px;
                right: -180px;
                background: radial-gradient(circle,rgba(26,90,200,0.22) 0%,rgba(14,31,74,0) 70%)
            }

            .bc2 {
                width: 500px;
                height: 500px;
                bottom: -120px;
                left: -140px;
                background: radial-gradient(circle,rgba(19,56,130,0.2) 0%,transparent 70%)
            }

            .bc3 {
                width: 350px;
                height: 350px;
                top: 50%;
                right: 3%;
                transform: translateY(-50%);
                background: radial-gradient(circle,rgba(27,79,191,0.15) 0%,transparent 70%)
            }

            .bc4 {
                width: 250px;
                height: 250px;
                bottom: 8%;
                left: 4%;
                background: radial-gradient(circle,rgba(21,41,96,0.25) 0%,transparent 70%)
            }
            /* ring overlays */
            .bg-ring {
                position: absolute;
                border-radius: 50%;
                border: 1px solid rgba(100,149,237,0.08)
            }

            .br1 {
                width: 800px;
                height: 800px;
                top: -250px;
                right: -250px
            }

            .br2 {
                width: 580px;
                height: 580px;
                top: -130px;
                right: -130px
            }

            .br3 {
                width: 580px;
                height: 580px;
                bottom: -180px;
                left: -180px
            }

            .br4 {
                width: 420px;
                height: 420px;
                bottom: -100px;
                left: -100px
            }

            /* ── STATUS BAR ── */
            .status-bar {
                position: relative;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: rgba(15,35,90,0.55);
                backdrop-filter: blur(16px);
                border: 1px solid rgba(100,160,255,0.15);
                border-radius: 30px;
                padding: 8px 20px;
                width: 420px;
                margin-bottom: 16px;
                animation: slideDown .5s ease both;
            }
            @@keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-10px)
                }

                to {
                    opacity: 1;
                    transform: translateY(0)
                }
            }

            .status-left {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 500;
                color: rgba(255,255,255,0.85)
            }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--teal);
                flex-shrink: 0;
                box-shadow: 0 0 8px var(--teal);
                animation: pulse 2s ease-in-out infinite
            }
            @@keyframes pulse {
                0%, 100% {
                    opacity: 1;
                    transform: scale(1)
                }

                50% {
                    opacity: .7;
                    transform: scale(1.2)
                }
            }

            .status-time {
                font-family: var(--mono);
                font-size: 13px;
                color: rgba(255,255,255,0.75);
                font-weight: 500
            }

            /* ── CARD ── */
            .login-card {
                position: relative;
                z-index: 10;
                background: var(--white);
                border-radius: 20px;
                width: 420px;
                padding: 0;
                overflow: hidden;
                box-shadow: 0 40px 100px rgba(5,15,50,0.6),0 0 0 1px rgba(150,180,255,0.12);
                animation: cardIn .55s cubic-bezier(.16,1,.3,1) both;
                animation-delay: .1s;
            }
            @@keyframes cardIn {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(.97)
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1)
                }
            }

            /* top accent line */
            .card-accent {
                height: 4px;
                background: linear-gradient(90deg,var(--teal),var(--blue-light),var(--orange));
                width: 100%
            }

            .card-inner {
                padding: 32px 36px 28px
            }

            /* ── BRAND ── */
            .brand-row {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 28px
            }

            .brand-logo {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                background: linear-gradient(135deg,var(--orange) 0%,#FBBF24 50%,var(--blue-light) 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                box-shadow: 0 4px 16px rgba(249,115,22,0.3);
                border: 3px solid var(--white);
                outline: 2px solid rgba(249,115,22,0.2);
            }

                .brand-logo i {
                    color: #fff;
                    font-size: 24px;
                    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3))
                }

            .brand-info .brand-title {
                font-size: 20px;
                font-weight: 700;
                color: #1A4FA8;
                letter-spacing: -0.3px
            }

            .brand-info .brand-sub {
                font-size: 12px;
                color: var(--text2);
                margin-top: 2px
            }

            /* ── ROLE TABS ── */
            .role-tabs {
                display: flex;
                background: #F1F5F9;
                border-radius: 10px;
                padding: 3px;
                gap: 2px;
                margin-bottom: 24px
            }

            .role-tab {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                padding: 8px 4px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 600;
                color: #64748B;
                cursor: pointer;
                border: none;
                background: none;
                font-family: var(--font);
                transition: all .2s;
                white-space: nowrap;
            }

                .role-tab i {
                    font-size: 14px
                }

                .role-tab.active {
                    background: var(--white);
                    color: var(--blue-light);
                    box-shadow: 0 2px 6px rgba(0,0,0,0.1)
                }

                .role-tab.admin.active {
                    color: #DC2626
                }

                .role-tab.staff.active {
                    color: var(--orange)
                }

                .role-tab.warehouse.active {
                    color: var(--blue-light)
                }

            /* ── ALERT ── */
            .alert-box {
                display: none;
                align-items: center;
                gap: 9px;
                padding: 10px 13px;
                border-radius: 9px;
                font-size: 12px;
                font-weight: 500;
                margin-bottom: 16px;
            }

                .alert-box.show {
                    display: flex
                }

            .alert-error {
                background: #FEF2F2;
                border: 1px solid #FECACA;
                color: #DC2626
            }

                .alert-error i {
                    font-size: 16px;
                    flex-shrink: 0
                }

            .alert-success {
                background: #F0FDF4;
                border: 1px solid #BBF7D0;
                color: #16A34A
            }

                .alert-success i {
                    font-size: 16px;
                    flex-shrink: 0
                }

            /* ── FORM ── */
            .field-group {
                margin-bottom: 16px
            }

            .field-label {
                font-size: 11px;
                font-weight: 700;
                color: #94A3B8;
                letter-spacing: .7px;
                text-transform: uppercase;
                margin-bottom: 7px
            }

            .field-box {
                display: flex;
                align-items: center;
                background: var(--input-bg);
                border: 1.5px solid var(--border);
                border-radius: 10px;
                overflow: hidden;
                transition: all .2s;
            }

                .field-box:focus-within {
                    border-color: #1A4FA8;
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(26,74,168,0.12)
                }

            .field-prefix {
                width: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #94A3B8;
                font-size: 17px;
                padding: 12px 0;
                flex-shrink: 0;
                border-right: 1.5px solid var(--border);
                transition: all .2s;
            }

            .field-box:focus-within .field-prefix {
                color: #1A4FA8;
                border-right-color: rgba(26,74,168,0.2)
            }

            .field-box input {
                flex: 1;
                border: none;
                background: none;
                outline: none;
                padding: 12px 13px;
                font-family: var(--font);
                font-size: 14px;
                color: var(--text);
            }

                .field-box input::placeholder {
                    color: #CBD5E1
                }

            .field-eye {
                padding: 0 13px;
                color: #94A3B8;
                cursor: pointer;
                font-size: 17px;
                transition: color .15s
            }

                .field-eye:hover {
                    color: var(--blue-light)
                }

            /* remember / forgot */
            .form-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px
            }

            .remember-wrap {
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer
            }

            .custom-cb {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border: 1.5px solid #CBD5E1;
                background: var(--input-bg);
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all .15s;
                flex-shrink: 0;
            }

            .remember-wrap:hover .custom-cb {
                border-color: #1A4FA8
            }

            .remember-wrap input[type=checkbox] {
                display: none
            }

            .remember-wrap input:checked ~ .custom-cb {
                background: #1A4FA8;
                border-color: #1A4FA8
            }

            .custom-cb i {
                font-size: 11px;
                color: #fff;
                opacity: 0;
                transition: opacity .15s
            }

            .remember-wrap input:checked ~ .custom-cb i {
                opacity: 1
            }

            .remember-label {
                font-size: 13px;
                color: var(--text2)
            }

            .forgot-link {
                font-size: 13px;
                color: #1A6FD4;
                cursor: pointer;
                font-weight: 500;
                transition: color .15s
            }

                .forgot-link:hover {
                    color: #1A4FA8
                }

            /* sign in btn */
            .signin-btn {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(135deg,#1A3A7A,#0E2257);
                color: #fff;
                font-family: var(--font);
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                transition: all .2s;
                letter-spacing: .2px;
                box-shadow: 0 4px 20px rgba(10,25,80,0.4);
                margin-bottom: 20px;
            }

                .signin-btn:hover {
                    background: linear-gradient(135deg,#1E4490,#0B1B4A);
                    transform: translateY(-1px);
                    box-shadow: 0 8px 26px rgba(10,25,80,0.5)
                }

                .signin-btn:active {
                    transform: translateY(0)
                }

                .signin-btn i {
                    font-size: 18px
                }

                .signin-btn.loading {
                    opacity: .75;
                    pointer-events: none
                }

            .spinner {
                width: 18px;
                height: 18px;
                border: 2px solid rgba(255,255,255,.3);
                border-top-color: #fff;
                border-radius: 50%;
                animation: spin .7s linear infinite;
                flex-shrink: 0
            }
            @@keyframes spin {
                to {
                    transform: rotate(360deg)
                }
            }

            /* PIN MODE */
            .pin-section {
                display: none
            }

            .pin-display {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                padding: 16px;
                margin-bottom: 14px;
                background: var(--input-bg);
                border: 1.5px solid var(--border);
                border-radius: 10px;
            }

            .pin-dot {
                width: 14px;
                height: 14px;
                border-radius: 50%;
                border: 1.5px solid #CBD5E1;
                transition: all .2s
            }

                .pin-dot.filled {
                    background: #1A4FA8;
                    border-color: #1A4FA8;
                    transform: scale(1.1)
                }

            .pin-grid {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 8px;
                margin-bottom: 14px
            }

            .pin-key {
                padding: 14px;
                border-radius: 9px;
                background: var(--input-bg);
                border: 1.5px solid var(--border);
                color: var(--text);
                font-family: var(--font);
                font-size: 17px;
                font-weight: 600;
                cursor: pointer;
                transition: all .15s;
                text-align: center;
            }

                .pin-key:hover {
                    background: #EFF6FF;
                    border-color: #1A4FA8;
                    color: #1A4FA8
                }

                .pin-key:active {
                    transform: scale(.93)
                }

                .pin-key.del {
                    font-size: 13px;
                    color: var(--red,#DC2626)
                }

                .pin-key.go {
                    background: linear-gradient(135deg,#1A3A7A,#0E2257);
                    border-color: #1A3A7A;
                    color: #fff;
                    font-size: 14px
                }

                    .pin-key.go:hover {
                        opacity: .9
                    }



            /* auth mode toggle */
            .auth-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                margin-bottom: 18px
            }

            .auth-toggle-btn {
                display: flex;
                align-items: center;
                gap: 5px;
                padding: 6px 13px;
                border-radius: 7px;
                border: 1.5px solid var(--border);
                font-size: 12px;
                font-weight: 600;
                color: var(--text2);
                cursor: pointer;
                background: none;
                font-family: var(--font);
                transition: all .15s;
            }

                .auth-toggle-btn.active {
                    border-color: #1A4FA8;
                    color: #1A4FA8;
                    background: #EFF6FF
                }

                .auth-toggle-btn i {
                    font-size: 14px
                }

            /* security badges */
            .security-badges {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 18px;
                padding-top: 16px;
                border-top: 1px solid var(--border)
            }

            .sec-badge {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 11px;
                color: #94A3B8
            }

                .sec-badge i {
                    font-size: 14px;
                    color: #CBD5E1
                }

            /* version */
            .version-bar {
                position: relative;
                z-index: 10;
                margin-top: 16px;
                font-size: 11px;
                color: rgba(180,200,255,0.35);
                display: flex;
                align-items: center;
                gap: 8px;
                animation: slideDown .5s ease .2s both;
            }

                .version-bar span {
                    color: rgba(180,200,255,0.55)
                }

            /* ── RESPONSIVE TABLET ≤640px ── */
            @@media(max - width:640px) {
                .status-bar, .login-card {
                    width: min(420px,94vw)
                }

                .card-inner {
                    padding: 26px 26px 22px
                }

                .brand-logo {
                    width: 44px;
                    height: 44px
                }

                    .brand-logo i {
                        font-size: 20px
                    }

                .brand-info .brand-title {
                    font-size: 18px
                }
            }

            /* ── RESPONSIVE PHONE ≤440px ── */
            @@media(max - width:440px) {
                html, body {
                    overflow: auto
                }

                .status-bar {
                    width: 92vw;
                    padding: 7px 16px
                }

                .login-card {
                    width: 92vw;
                    border-radius: 16px
                }

                .card-inner {
                    padding: 22px 20px 18px
                }

                .brand-row {
                    margin-bottom: 20px
                }

                .brand-logo {
                    width: 40px;
                    height: 40px
                }

                    .brand-logo i {
                        font-size: 18px
                    }

                .brand-info .brand-title {
                    font-size: 16px
                }

                .role-tab {
                    font-size: 10px;
                    padding: 7px 2px
                }

                    .role-tab i {
                        font-size: 12px
                    }

                .signin-btn {
                    padding: 13px;
                    font-size: 14px
                }

                .pin-key {
                    padding: 12px;
                    font-size: 16px
                }

                .security-badges {
                    gap: 10px
                }

                .sec-badge {
                    font-size: 10px
                }

                .version-bar {
                    font-size: 10px
                }
            }
    </style>
    <script src="~/js/login.js"></script>
</head>
<body>
    <!-- BG -->
    <div class="bg-wrap">
        <div class="bg-circle bc1"></div>
        <div class="bg-circle bc2"></div>
        <div class="bg-circle bc3"></div>
        <div class="bg-circle bc4"></div>
        <div class="bg-ring br1"></div>
        <div class="bg-ring br2"></div>
        <div class="bg-ring br3"></div>
        <div class="bg-ring br4"></div>
    </div>

    <!-- STATUS BAR -->
    <div class="status-bar">
        <div class="status-left">
            <div class="status-dot"></div>
            System Online
        </div>
        <div class="status-time" id="statusClock">--:-- -- --</div>
    </div>

    <!-- CARD -->
    <div class="login-card">
        <div class="card-accent"></div>
        <div class="card-inner">

            <!-- BRAND -->
            <div class="brand-row">
                <div class="brand-logo"><i class="ti ti-shopping-bag"></i></div>
                <div class="brand-info">
                    <div class="brand-title" id="cardTitle">Point of Sale</div>
                    <div class="brand-sub" id="cardSub">Enter your credentials to sign in</div>
                </div>
            </div>

            <!-- ROLE TABS -->
            <div class="role-tabs">
                <button class="role-tab staff active" id="tab-staff" onclick="selectRole('staff')">
                    <i class="ti ti-user-circle"></i> Staff
                </button>
                <button class="role-tab admin" id="tab-admin" onclick="selectRole('admin')">
                    <i class="ti ti-shield-lock"></i> Admin
                </button>
                <button class="role-tab warehouse" id="tab-warehouse" onclick="selectRole('warehouse')">
                    <i class="ti ti-building-warehouse"></i> Warehouse
                </button>
            </div>

            <!-- AUTH MODE TOGGLE -->
            <div class="auth-toggle">
                <button class="auth-toggle-btn active" id="btnPwd" onclick="switchAuth('pwd')">
                    <i class="ti ti-lock"></i> Password
                </button>
                <button class="auth-toggle-btn" id="btnPin" onclick="switchAuth('pin')">
                    <i class="ti ti-keyframe-align-center"></i> Quick PIN
                </button>
            </div>

            <!-- ALERT -->
            <div class="alert-box" id="alertBox">
                <i class="ti ti-alert-circle" id="alertIcon"></i>
                <span id="alertText"></span>
            </div>

            <!-- PASSWORD FORM -->
            <div id="pwdForm">
                <div class="field-group">
                    <div class="field-label">User ID</div>
                    <div class="field-box">
                        <div class="field-prefix"><i class="ti ti-id-badge-2"></i></div>
                        <input type="text" id="userId" placeholder="Enter your User ID" autocomplete="username">
                    </div>
                </div>
                <div class="field-group">
                    <div class="field-label">Password</div>
                    <div class="field-box">
                        <div class="field-prefix"><i class="ti ti-lock"></i></div>
                        <input type="password" id="userPwd" placeholder="Enter your password" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()">
                        <div class="field-eye" onclick="togglePwd()" id="eyeIcon"><i class="ti ti-eye"></i></div>
                    </div>
                </div>
                <div class="form-meta">
                    <label class="remember-wrap">
                        <input type="checkbox" id="rememberMe">
                        <div class="custom-cb"><i class="ti ti-check"></i></div>
                        <span class="remember-label">Remember me</span>
                    </label>
                    <span class="forgot-link" onclick="doForgot()">Forgot password?</span>
                </div>
            </div>

            <!-- PIN FORM -->
            <div id="pinForm" class="pin-section">
                <div class="field-group">
                    <div class="field-label">User ID</div>
                    <div class="field-box">
                        <div class="field-prefix"><i class="ti ti-id-badge-2"></i></div>
                        <input type="text" id="pinUserId" placeholder="Enter your User ID">
                    </div>
                </div>
                <div class="pin-display">
                    <div class="pin-dot" id="pd0"></div>
                    <div class="pin-dot" id="pd1"></div>
                    <div class="pin-dot" id="pd2"></div>
                    <div class="pin-dot" id="pd3"></div>
                </div>
                <div class="pin-grid">
                    <button class="pin-key" onclick="pinPress('1')">1</button>
                    <button class="pin-key" onclick="pinPress('2')">2</button>
                    <button class="pin-key" onclick="pinPress('3')">3</button>
                    <button class="pin-key" onclick="pinPress('4')">4</button>
                    <button class="pin-key" onclick="pinPress('5')">5</button>
                    <button class="pin-key" onclick="pinPress('6')">6</button>
                    <button class="pin-key" onclick="pinPress('7')">7</button>
                    <button class="pin-key" onclick="pinPress('8')">8</button>
                    <button class="pin-key" onclick="pinPress('9')">9</button>
                    <button class="pin-key del" onclick="pinPress('del')"><i class="ti ti-backspace"></i></button>
                    <button class="pin-key" onclick="pinPress('0')">0</button>
                    <button class="pin-key go" onclick="doPinLogin()"><i class="ti ti-login"></i></button>
                </div>
            </div>

            <!-- SIGN IN BUTTON (password mode) -->
            <button class="signin-btn" id="signinBtn" onclick="doLogin()">
                <i class="ti ti-login-2"></i> Sign in
            </button>

            <!-- SECURITY BADGES -->
            <div class="security-badges">
                <div class="sec-badge"><i class="ti ti-refresh"></i>256-bit encryption</div>
                <div class="sec-badge"><i class="ti ti-shield-check"></i>Access monitored</div>
                <div class="sec-badge"><i class="ti ti-user-check"></i>Authorized only</div>
            </div>

        </div>
    </div>

    <!-- VERSION -->
    <div class="version-bar" style="flex-direction:column;gap:4px;align-items:center">
        <div style="display:flex;align-items:center;gap:8px">
            <span style="width:18px;height:18px;background:linear-gradient(135deg,#1A4FA8,#00C9A7);border-radius:5px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="ti ti-planet" style="font-size:11px;color:#fff"></i>
            </span>
            <span style="color:rgba(180,200,255,0.75);font-weight:600;font-size:12px">Powered by Orions InfoTech Solution</span>
        </div>
        <span style="color:rgba(180,200,255,0.35);font-size:11px">POS Service &nbsp;·&nbsp; v2.5.1 &nbsp;·&nbsp; &copy; 2025 All Rights Reserved</span>
    </div>


</body>
