@model POSModels.Models.MithaiShop.CategoryModel

@{
    ViewData["Title"] = "Category";
    Layout = "/Views/Shared/_SideLayout.cshtml";
}
<style>


/* ══════════════════════════════════
   CARD
══════════════════════════════════ */
.card {
    background: #ffffff;
    border: 0.5px solid #e5e5e3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.25rem;
}

.card-header {
    background: #fafaf9;
    border-bottom: 0.5px solid #e5e5e3;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

    .card-header i {
        font-size: 18px;
        color: #888780;
    }

    .card-header h4 {
        margin: 0;
        font-size: 14px;
        font-weight: 500;
        color: #1a1a18;
        letter-spacing: 0.01em;
    }

/* ══════════════════════════════════
   FORM LABELS
══════════════════════════════════ */
label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #888780;
    display: block;
    margin-bottom: 5px;
}

/* ══════════════════════════════════
   INPUTS
══════════════════════════════════ */
.form-control {
    padding: 8px 12px;
    border: 0.5px solid #c8c7c0;
    border-radius: 8px;
    background: #f7f7f5;
    font-size: 13.5px;
    color: #1a1a18;
    width: 100%;
    transition: border-color 0.15s, box-shadow 0.15s;
}

    .form-control:focus {
        outline: none;
        border-color: #378add;
        box-shadow: 0 0 0 3px rgba(55, 138, 221, 0.12);
        background: #ffffff;
    }

    .form-control::placeholder {
        color: #b4b2a9;
    }

/* ══════════════════════════════════
   SAVE / UPDATE BUTTON
══════════════════════════════════ */
#btnSave {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 20px;
    background: #0f6e56;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.15s;
}

    #btnSave:hover {
        opacity: 0.85;
    }

    #btnSave i {
        font-size: 16px;
    }

/* ══════════════════════════════════
   TABLE
══════════════════════════════════ */
.table {
    font-size: 13px;
    width: 100%;
    border-collapse: collapse;
}

    .table thead th {
        background: #f7f7f5;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 500;
        color: #888780;
        border-bottom: 0.5px solid #e5e5e3;
        padding: 10px 14px;
        text-align: left;
        white-space: nowrap;
    }

    .table td {
        padding: 10px 14px;
        vertical-align: middle;
        border-bottom: 0.5px solid #f0efea;
        color: #1a1a18;
    }

    .table tbody tr:hover td {
        background: #fafaf9;
    }

    .table tbody tr:last-child td {
        border-bottom: none;
    }

/* Category Code pill */
.table td code {
    font-size: 12px;
    background: #f7f7f5;
    padding: 2px 8px;
    border-radius: 4px;
    border: 0.5px solid #e5e5e3;
    color: #5f5e5a;
}

/* ══════════════════════════════════
   EDIT BUTTON
══════════════════════════════════ */
.btn-warning.btn-sm {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    background: #faeeda;
    color: #854f0b;
    border: 0.5px solid #ef9f27;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.15s;
}

    .btn-warning.btn-sm:hover {
        opacity: 0.8;
    }

    .btn-warning.btn-sm i {
        font-size: 14px;
    }

/* ══════════════════════════════════
   VALIDATION ERROR
══════════════════════════════════ */
.text-danger {
    font-size: 11.5px;
    color: #a32d2d;
    margin-top: 3px;
    display: block;
}

/* ══════════════════════════════════
   ROW SERIAL NUMBER BADGE
══════════════════════════════════ */
.badge-num {
    display: inline-block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #f0efea;
    border: 0.5px solid #e5e5e3;
    font-size: 11px;
    font-weight: 500;
    color: #888780;
    text-align: center;
    line-height: 22px;
}

</style>
<!-- DATATABLE CSS -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<div class="card shadow-sm">

    <div class="card-header">
        <h4>Add / Update Category</h4>
    </div>

    <div class="card-body">

        <form id="categoryForm">

            <input asp-for="Id" type="hidden" id="Id" />

            <div class="row">

                <div class="col-md-6">

                    <label>Category Name</label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           id="CategoryName" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label>Category Code</label>

                    <input asp-for="CategoryCode"
                           class="form-control"
                           id="CategoryCode" />

                    <span asp-validation-for="CategoryCode"
                          class="text-danger"></span>

                </div>

                <div class="col-md-12 mt-3">

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnSave">
                        Save
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<br />

<div class="card shadow-sm">

    <div class="card-header">
        <h4>Category List</h4>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-striped"
               id="categoryTable">

            <thead class="table-dark">

                <tr>
                    <th>#</th>
                    <th>Category Name</th>
                    <th>Category Code</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody></tbody>

        </table>

    </div>

</div>

<!-- JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- DATATABLE JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>

    $(document).ready(function () {

        // LOAD CATEGORY LIST
        loadCategory();

        // FORM SUBMIT
        $("#categoryForm").on("submit", function (e) {

            e.preventDefault();

            var model = {

                Id: $("#Id").val(),

                CategoryName: $("#CategoryName").val(),

                CategoryCode: $("#CategoryCode").val()
            };

            console.log(model);

            $.ajax({

                url: '/Home/AddCategory',

                type: 'POST',

                data: model,

                success: function (res) {

                    if (res.status == true) {

                        alert(res.message);

                        // RESET FORM
                        $("#categoryForm")[0].reset();

                        $("#Id").val('');

                        $("#btnSave").text("Save");

                        // RELOAD TABLE
                        loadCategory();
                    }
                    else {

                        alert(res.message);
                    }
                },

                error: function (xhr, status, error) {

                    console.log(error);

                    alert("Error while saving category");
                }
            });

        });

    });

        function loadCategory() {

        // CHECK DATATABLE EXISTS
        if ($.fn.dataTable && $.fn.dataTable.isDataTable('#categoryTable')) {

            $('#categoryTable').DataTable().destroy();
        }

        $.ajax({

            url: '/Home/AllCategoryList',

            type: 'GET',

            success: function (res) {

                var html = '';
                console.log(res);
                $.each(res.data, function (i, item) {
                    
                    html += `
                        <tr>

                            <td>${i + 1}</td>

                            <td>${item.categoryName}</td>

                            <td>${item.categoryCode}</td>

                            <td>

                                <button
                                    type="button"
                                    class="btn btn-warning btn-sm"
                                    onclick='editCategory(${JSON.stringify(item)})'>

                                    Edit

                                </button>

                            </td>

                        </tr>
                    `;
                });

                $("#categoryTable tbody").html(html);

                // INIT DATATABLE
                $('#categoryTable').DataTable();
            },

            error: function () {

                alert("Error loading category");
            }
        });
    }

    // EDIT CATEGORY
    function editCategory(item) {

        $("#Id").val(item.id);

        $("#CategoryName").val(item.categoryName);

        $("#CategoryCode").val(item.categoryCode);

        $("#btnSave").text("Update");

        // SCROLL TO TOP
        window.scrollTo({

            top: 0,

            behavior: 'smooth'
        });
    }

</script>