@model POSModels.Models.StaffModel

@{
    ViewBag.Title = "Create Staff";
    Layout = "~/Views/Shared/_SideLayout.cshtml";
}

<div class="pos-container">

    <!-- HEADER -->
    <div class="page-header">
        <div class="header-left">
            <a href="@Url.Action("Index", "Staff")" class="back-btn">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1>Create Staff</h1>
                <p class="breadcrumb-text">Staff Management › Add New Staff</p>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("CreateStaff", "Home", FormMethod.Post, new { @class = "staff-form", enctype = "multipart/form-data", id = "staffForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-grid">

            <!-- LEFT SIDE -->
          @*   <div class="form-left">
                <div class="card avatar-card">

                    <div class="avatar-upload-area" id="avatarArea">
                        <img id="avatarPreview" style="display:none;" />

                        <div id="avatarPlaceholder">
                            <i class="fas fa-user-plus"></i>
                            <p>Upload Photo</p>
                            <span>JPG, PNG (Max 2MB)</span>
                        </div>

                        <input type="file" id="avatarInput" name="ProfilePhoto" class="avatar-file-input" />
                    </div>

                </div>
            </div> *@

            <!-- RIGHT SIDE -->
            <div class="form-right">

                <div class="card">
                    <div class="card-title">
                        <i class="fas fa-user"></i> Personal Information
                    </div>
                    <hr /><br /> 
                    <div class="two-col">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Name)
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Full Name" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Mobileno)
                            @Html.TextBoxFor(m => m.Mobileno, new { @class = "form-control", placeholder = "Mobile Number" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Address)
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = 3, placeholder = "Full Address" })
                    </div>

                    <div class="two-col">
                        <div class="form-group">
                            @Html.LabelFor(m => m.DOB)
                            @Html.TextBoxFor(m => m.DOB, new { @class = "form-control", type = "date" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.AadharCardNo)
                            @Html.TextBoxFor(m => m.AadharCardNo, new { @class = "form-control", placeholder = "Aadhar Number" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.StaffCode)
                        @Html.TextBoxFor(m => m.StaffCode, new { @class = "form-control", id = "staffCode" })
                    </div>
                   <div class="form-group">
                        @Html.LabelFor(m => m.ShopName)
                        @Html.DropDownListFor(m => m.Shopid,Model.selectedshoplist,"-- Select Shop --",new { @class = "form-control", id = "shopcode" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email" })
                    </div>

                    <div class="form-group">
                        @Html.Label("Password")
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "Password", placeholder = "Password" })
                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="form-actions">
                    <button type="reset" class="btn-reset">Reset</button>
                    <button type="button" class="btn-submit" onclick="submitStaff()">Save Staff</button>
                </div>

            </div>

        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Auto staff code
        var code = "STF-" + Math.floor(Math.random() * 9000 + 1000);
        document.getElementById("staffCode").value = code;

        // Image preview
        document.getElementById("avatarInput").addEventListener("change", function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (ev) {
                    document.getElementById("avatarPreview").src = ev.target.result;
                    document.getElementById("avatarPreview").style.display = "block";
                    document.getElementById("avatarPlaceholder").style.display = "none";
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById("avatarArea").addEventListener("click", function () {
            document.getElementById("avatarInput").click();
        });

    });

    function submitStaff() {

        var form = document.getElementById("staffForm");
        var formData = new FormData(form);

        fetch('/Home/CreateStaff', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {

            if (data.result === true) {

                alert("✔ " + data.message);

                // reset form
                form.reset();

                // regenerate staff code
                var code = "STF-" + Math.floor(Math.random() * 9000 + 1000);
                document.getElementById("staffCode").value = code;

            } else {
                alert("❌ " + data.message);
            }

        })
        .catch(error => {
            console.log(error);
            alert("Something went wrong");
        });
    }

</script>


    <style>

        :root {
            --primary: #2563EB;
            --bg: #F1F5F9;
            --card: #fff;
            --border: #E2E8F0;
        }

        .pos-container {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
            background: var(--bg);
            min-height: 100vh;
        }

        /* GRID */
        .form-grid {
            display: grid;
            /* grid-template-columns: 240px 1fr; */
            gap: 20px;
        }

        /* CARD */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
        }

        /* AVATAR */
        .avatar-upload-area {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 2px dashed var(--primary);
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            overflow: hidden;
        }

            .avatar-upload-area img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* FORM */
        .form-group {
            margin-bottom: 12px;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        /* TWO COL */
        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* BUTTONS */
        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-submit {
            background: var(--primary);
            color: #fff;
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
        }

        .btn-reset {
            background: #fff;
            border: 1px solid var(--border);
            padding: 10px 18px;
            border-radius: 8px;
        }

    </style>
