@model List<POSModels.Models.MithaiShop.ProductionList>
@{
    ViewData["Title"] = "Production List";
    Layout = "/Views/Shared/_SideLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
<style>
    /* ── Page ── */
    .pl-page {
        padding: 1.5rem 1rem;
    }

    /* ── Header ── */
    .pl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pl-title-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pl-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #0C447C;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .pl-icon-box i {
            font-size: 21px;
            color: #fff;
        }

    .pl-title {
        font-size: 19px;
        font-weight: 700;
        color: #0C447C;
        margin: 0;
    }

    .pl-subtitle {
        font-size: 12px;
        color: #888780;
        margin: 0;
    }

    /* ── Add Button ── */
    .btn-add-prod {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #0C447C;
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 10px 18px;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: opacity .2s;
    }

        .btn-add-prod:hover {
            opacity: .85;
            color: #fff;
        }

    /* ── Stat Cards ── */
    .pl-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 10px;
        margin-bottom: 1.25rem;
    }

    .stat-card {
        background: #fff;
        border-radius: 11px;
        padding: 13px 15px;
        border: 0.5px solid #e2e8f0;
    }

    .stat-label {
        font-size: 11px;
        color: #888780;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 4px;
    }

    .stat-val {
        font-size: 22px;
        font-weight: 700;
        color: #0C447C;
    }

    .stat-sub {
        font-size: 11px;
        color: #5DCAA5;
        margin-top: 2px;
    }

    /* ── Main Card ── */
    .pl-card {
        background: #fff;
        border-radius: 14px;
        border: 0.5px solid #e2e8f0;
        overflow: hidden;
    }

    /* ── Toolbar ── */
    .pl-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 16px;
        border-bottom: 0.5px solid #e9ecef;
        flex-wrap: wrap;
        gap: 8px;
    }

    .search-wrap {
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 15px;
            color: #888780;
            pointer-events: none;
        }

        .search-wrap input {
            border: 0.5px solid #dde3ea;
            border-radius: 8px;
            padding: 7px 10px 7px 32px;
            font-size: 13px;
            width: 220px;
            color: #2c3e50;
            background: #f8fafd;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .search-wrap input:focus {
                border-color: #185FA5;
                box-shadow: 0 0 0 3px rgba(24,95,165,.1);
            }

    .entries-label {
        font-size: 13px;
        color: #888780;
    }

        .entries-label select {
            border: 0.5px solid #dde3ea;
            border-radius: 7px;
            padding: 5px 8px;
            font-size: 13px;
            color: #2c3e50;
            background: #f8fafd;
            outline: none;
            margin-left: 4px;
        }

    /* ── Table ── */
    .tbl-scroll {
        overflow-x: auto;
    }

    #productionTable {
        width: 100% !important;
        border-collapse: collapse !important;
    }

        #productionTable thead {
            background: #0C447C;
        }

            #productionTable thead th {
                color: #E6F1FB;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
                padding: 12px 14px;
                border: none;
                white-space: nowrap;
            }

        #productionTable tbody td {
            font-size: 13.5px;
            color: #2c3e50;
            padding: 11px 14px;
            border-bottom: 0.5px solid #f0f3f7;
            vertical-align: middle;
            white-space: nowrap;
        }

        #productionTable tbody tr:last-child td {
            border-bottom: none;
        }

        #productionTable tbody tr:hover {
            background: #f7fbff;
        }

    /* Badges */
    .sno-badge {
        display: inline-flex;
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: #E6F1FB;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        color: #0C447C;
    }

    .prod-no {
        font-weight: 600;
        color: #185FA5;
        font-size: 13px;
    }

    .qty-badge {
        display: inline-block;
        background: #EAF3DE;
        color: #27500A;
        border-radius: 6px;
        padding: 2px 9px;
        font-size: 12.5px;
        font-weight: 500;
    }

    .cost-badge {
        display: inline-block;
        background: #FAEEDA;
        color: #633806;
        border-radius: 6px;
        padding: 2px 9px;
        font-size: 12.5px;
        font-weight: 500;
    }

    .cat-pill {
        display: inline-block;
        background: #EEEDFE;
        color: #3C3489;
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 11.5px;
    }

    /* DataTables overrides */
    .dataTables_wrapper .dataTables_filter {
        display: none;
    }

    .dataTables_wrapper .dataTables_length {
        display: none;
    }

    .dataTables_wrapper .dataTables_info {
        font-size: 12.5px;
        color: #888780;
        padding: 10px 16px;
    }

    .dataTables_wrapper .dataTables_paginate {
        padding: 8px 16px;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border: 0.5px solid #dde3ea !important;
            border-radius: 7px !important;
            padding: 4px 10px !important;
            font-size: 13px !important;
            color: #0C447C !important;
            background: #fff !important;
            margin: 0 2px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background: #0C447C !important;
                color: #fff !important;
                border-color: #0C447C !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: #E6F1FB !important;
                color: #0C447C !important;
            }

    /* ══════════════════════════════
           MOBILE — Card Layout
        ══════════════════════════════ */
    .mob-cards {
        display: none;
        padding: 12px;
    }

    .mob-card {
        background: #fff;
        border: 0.5px solid #e2e8f0;
        border-radius: 13px;
        margin-bottom: 12px;
        overflow: hidden;
    }

    .mob-card-head {
        background: #0C447C;
        padding: 13px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    .mob-card-head-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .mob-card-sno {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    .mob-card-name {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    .mob-card-no {
        font-size: 11.5px;
        color: #B5D4F4;
        margin-top: 1px;
    }

    .mob-chevron {
        font-size: 18px;
        color: rgba(255,255,255,.7);
        transition: transform .25s;
    }

    .mob-card.open .mob-chevron {
        transform: rotate(180deg);
    }

    .mob-card-body {
        display: none;
    }

    .mob-card.open .mob-card-body {
        display: block;
    }

    .mob-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 14px;
        border-bottom: 0.5px solid #f0f3f7;
    }

        .mob-row:last-child {
            border-bottom: none;
        }

    .mob-lbl {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #888780;
        font-weight: 600;
    }

    .mob-val {
        font-size: 13px;
        color: #2c3e50;
        font-weight: 500;
        text-align: right;
    }

    @@media (max-width: 768px) {
        .tbl-scroll {
            display: none;
        }

        .mob-cards {
            display: block;
        }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            display: none;
        }

        .pl-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-add-prod {
            justify-content: center;
        }

        .pl-stats {
            grid-template-columns: 1fr 1fr;
        }

        .search-wrap input {
            width: 100%;
        }

        .pl-toolbar {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="pl-page">

    <div class="pl-header">
        <div class="pl-title-row">
            <div class="pl-icon-box"><i class="ti ti-clipboard-list"></i></div>
            <div>
                <h3 class="pl-title">Production List</h3>
                <p class="pl-subtitle">All production records</p>
            </div>
        </div>
        <a href="/Home/AddProduction" class="btn-add-prod">
            <i class="ti ti-plus"></i> Add Production
        </a>
    </div>

    <div class="pl-stats">
        <div class="stat-card">
            <div class="stat-label">Total Records</div>
            <div class="stat-val">@(Model?.Count ?? 0)</div>
            <div class="stat-sub">All time</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">This Month</div>
            <div class="stat-val">@(Model?.Count(x => x.CreatedDate.Month == DateTime.Now.Month) ?? 0)</div>
            <div class="stat-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Expiring Soon</div>
            <div class="stat-val" style="color:#854F0B">@(Model?.Count(x => (x.ExpiryDate - DateTime.Now).TotalDays <= 7 && x.ExpiryDate >= DateTime.Now) ?? 0)</div>
            <div class="stat-sub" style="color:#854F0B">Within 7 days</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Quantity</div>
            <div class="stat-val">@(Model?.Sum(x => x.Quantity) ?? 0)</div>
            <div class="stat-sub">All units</div>
        </div>
    </div>

    <div class="pl-card">
        <div class="pl-toolbar">
            <div class="search-wrap">
                <i class="ti ti-search"></i>
                <input type="text" id="liveSearch" placeholder="Search product, category…" />
            </div>
            <span class="entries-label">
                Show
                <select id="entriesSelect">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> entries
            </span>
        </div>

        <div class="tbl-scroll">
            <table id="productionTable" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Prod. No</th>
                        <th>Date</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Qty</th>
                        <th>Cost</th>
                        <th>Created</th>
                        <th>Expiry</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="sno-badge">@(i++)</span></td>
                                <td><span class="prod-no">@item.ProductionNo</span></td>
                                <td>@item.ProductionDate.ToString("dd-MM-yyyy")</td>
                                <td style="font-weight:600">@item.ProductName</td>
                                <td><span class="cat-pill">@item.CategoryName</span></td>
                                <td style="color:#5F5E5A">@item.Unit</td>
                                <td><span class="qty-badge">@item.Quantity</span></td>
                                <td><span class="cost-badge">₹@item.CostAmount.ToString("N0")</span></td>
                                <td style="color:#5F5E5A">@item.CreatedDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.ExpiryDate.ToString("dd-MM-yyyy")</td>
                                <td style="color:#888780">@item.Remarks</td>
                            </tr>
                             @* @(i++)  *@
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" style="text-align:center;padding:3rem;color:#888780">
                                <i class="ti ti-database-off" style="font-size:36px;display:block;margin-bottom:8px;color:#D3D1C7"></i>
                                No data found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards -->
        <div class="mob-cards" id="mobCards">
            @if (Model != null && Model.Count > 0)
            {
                int j = 1;
                foreach (var item in Model)
                {
                    <div class="mob-card">
                        <div class="mob-card-head" onclick="this.closest('.mob-card').classList.toggle('open')">
                            <div class="mob-card-head-left">
                                 <div class="mob-card-sno">@j</div> 
                                <div>
                                    <div class="mob-card-name">@item.ProductName</div>
                                    <div class="mob-card-no">@item.ProductionNo &bull; @item.ProductionDate.ToString("dd-MM-yyyy")</div>
                                </div>
                            </div>
                            <i class="ti ti-chevron-down mob-chevron"></i>
                        </div>
                        <div class="mob-card-body">
                            <div class="mob-row"><span class="mob-lbl">Category</span><span class="mob-val"><span class="cat-pill">@item.CategoryName</span></span></div>
                            <div class="mob-row"><span class="mob-lbl">Unit</span><span class="mob-val">@item.Unit</span></div>
                            <div class="mob-row"><span class="mob-lbl">Quantity</span><span class="mob-val"><span class="qty-badge">@item.Quantity</span></span></div>
                            <div class="mob-row"><span class="mob-lbl">Cost Amount</span><span class="mob-val"><span class="cost-badge">₹@item.CostAmount.ToString("N0")</span></span></div>
                            <div class="mob-row"><span class="mob-lbl">Created</span><span class="mob-val">@item.CreatedDate.ToString("dd-MM-yyyy")</span></div>
                            <div class="mob-row"><span class="mob-lbl">Expiry</span><span class="mob-val" style="color:#27500A">@item.ExpiryDate.ToString("dd-MM-yyyy")</span></div>
                            <div class="mob-row"><span class="mob-lbl">Remarks</span><span class="mob-val">@item.Remarks</span></div>
                        </div>
                    </div>
                     @(j++) 
                }
            }
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
    var dt = $('#productionTable').DataTable({ paging: true, searching: true, ordering: true, pageLength: 10 });

    document.getElementById('liveSearch').addEventListener('input', function () {
    dt.search(this.value).draw();
    });
    document.getElementById('entriesSelect').addEventListener('change', function () {
    dt.page.len(parseInt(this.value)).draw();
    });
</script>