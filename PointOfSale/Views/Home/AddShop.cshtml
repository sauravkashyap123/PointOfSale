@model POSModels.Models.ShopModel

@{
    ViewData["Title"] = "Shop Management";
    Layout = "/Views/Shared/_SideLayout.cshtml";
}

<link href="~/css/shop.css" rel="stylesheet" />

<div class="pos-page">

    <!-- PAGE HEADER -->
    <div class="pos-page-header">
        <div class="page-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 9.5L12 4l9 5.5V20H3V9.5z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20v-6h6v6" />
            </svg>
        </div>
        <div>
            <h1>Shop Management</h1>
            <p>Add, update and manage all shops</p>
        </div>
    </div>

    <!-- EDIT BANNER -->
    <div class="edit-banner" id="editBanner">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
            m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>You are currently editing a shop. Update the details and click <strong>Update Shop</strong>.</span>
        <button class="btn-cancel-edit" onclick="cancelEdit()">✕ Cancel Edit</button>
    </div>

    <!-- FORM CARD -->
    <div class="wh-card">
        <div class="wh-card-header">
            <div class="header-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <h4 id="formCardTitle">Add / Update Shop</h4>
        </div>
        <div class="wh-card-body">
            <form id="shopForm" autocomplete="off">

                <input type="hidden" id="Id" name="Id" value="0" />

                <div class="form-grid">

                    <div class="form-section-label">Shop Information</div>

                    <!-- Shop Name -->
                    <div class="form-group col-6">
                        <label for="ShopName">Shop Name <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M3 9.5L12 4l9 5.5V20H3V9.5z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20v-6h6v6" />
                            </svg>
                            <input type="text" id="ShopName" name="ShopName" class="form-control"
                                   placeholder="e.g. Main Street Store" required />
                        </div>
                    </div>

                    <!-- Owner Name -->
                    <div class="form-group col-6">
                        <label for="OwnerName">Owner Name</label>
                        <div class="input-wrap">
                            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <input type="text" id="OwnerName" name="OwnerName" class="form-control"
                                   placeholder="e.g. Rahul Kumar" />
                        </div>
                    </div>

                    <!-- Contact Number -->
                    <div class="form-group col-6">
                        <label for="ContactNumber">Contact Number</label>
                        <div class="input-wrap">
                            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493
                                a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516
                                l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19
                                a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                            <input type="text" id="ContactNumber" name="ContactNumber" class="form-control"
                                   placeholder="+91 98765 43210" />
                        </div>
                    </div>

                    <!-- Warehouse -->
                    <div class="form-group col-6">
                        <label for="WarehouseId">Select Warehouse <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                            </svg>
                            <select id="WarehouseId" name="WarehouseId" class="form-control select-control" required>
                                <option value="">-- Select Warehouse --</option>
                                @foreach (var item in Model.selectWarehouse)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                </div>

                <!-- FORM ACTIONS -->
                <div class="form-actions">
                    <button type="submit" class="btn-save" id="btnSave">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9
                            a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                        </svg>
                        <span id="btnSaveText">Save Shop</span>
                    </button>
                    <button type="button" class="btn-clear" onclick="cancelEdit()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9
                            m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Clear Form
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="wh-card">
        <div class="wh-card-header">
            <div class="header-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
            </div>
            <h4>Shop List</h4>
            <span class="badge" id="countBadge">Loading…</span>
            <div class="wh-table-search">
                <div class="search-wrap" id="customSearch" style="display:none">
                    <svg class="s-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" id="searchInput" placeholder="Search shops…" />
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table id="shopTable" class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Shop Name</th>
                        <th>Owner</th>
                        <th>Contact</th>
                        <th>Warehouse</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="shopTbody">
                    <tr class="empty-row">
                        <td colspan="6">Loading…</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="pagination-bar">
            <span class="pagination-info" id="pageInfo">Showing 0 of 0</span>
            <div class="pagination-btns" id="pageBtns"></div>
        </div>
    </div>

</div>

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/shop.js"></script>
