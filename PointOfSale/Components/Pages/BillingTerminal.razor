@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using POSModels.Models
@using POSModels.Services
@using System.Threading.Tasks
@inject IBillingService BillingService
@inject ICachedProductService CachedProductService
@inject IJSRuntime JSRuntime

<div class="pos-blazor-container font-sans text-gray-800">
    <!-- Top Stats & Header Bar -->
    <div class="pos-header flex justify-between items-center bg-slate-900 text-white p-4 rounded-xl shadow-lg mb-4">
        <div class="flex items-center space-x-3">
            <div class="p-2 bg-indigo-600 rounded-lg text-white font-bold text-xl shadow">⚡</div>
            <div>
                <h2 class="text-xl font-bold tracking-wide">Interactive Blazor POS Billing Terminal</h2>
                <p class="text-xs text-slate-400">High Speed Counter Billing & Real-Time Sync</p>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <div class="text-right">
                <span class="text-xs text-slate-400 block">Bill No:</span>
                <span class="text-base font-mono font-bold text-amber-400">@BillNo</span>
            </div>
            <button class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-3 py-2 rounded-lg transition shadow" @onclick="RefreshProducts">
                🔄 Sync Products
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div class="mb-4 p-3 rounded-lg text-sm font-semibold flex items-center justify-between shadow @(ToastType == "success" ? "bg-emerald-100 text-emerald-800 border-l-4 border-emerald-500" : "bg-rose-100 text-rose-800 border-l-4 border-rose-500")">
            <span>@ToastMessage</span>
            <button @onclick="() => ToastMessage = null" class="text-xs font-bold px-2">✕</button>
        </div>
    }

    <!-- Main POS Grid: Search/Products Left, Cart/Checkout Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        
        <!-- Left Section: Search & Product Cards (7 Cols) -->
        <div class="lg:col-span-7 bg-white p-4 rounded-xl shadow border border-slate-100 flex flex-col justify-between">
            <div>
                <!-- Search & Quick Filters -->
                <div class="relative mb-4">
                    <input type="text" 
                           class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
                           placeholder="🔍 Search Product by Code, Barcode, or Name..." 
                           @bind="SearchQuery" 
                           @bind:event="oninput" />
                </div>

                <!-- Product Grid -->
                @if (IsLoading)
                {
                    <div class="flex justify-center items-center py-12 text-slate-400">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mr-2"></div>
                        <span>Loading catalog...</span>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-h-[500px] overflow-y-auto pr-1">
                        @foreach (var prod in FilteredProducts)
                        {
                            <div class="product-card bg-slate-50 hover:bg-indigo-50/50 border border-slate-200 hover:border-indigo-300 p-3 rounded-xl cursor-pointer transition transform hover:-translate-y-0.5 shadow-sm flex flex-col justify-between"
                                 @onclick="() => AddToCart(prod)">
                                <div>
                                    <div class="flex justify-between items-start mb-1">
                                        <span class="text-xs font-mono px-2 py-0.5 bg-slate-200 text-slate-700 rounded font-semibold">@prod.ProductCode</span>
                                        <span class="text-[10px] px-1.5 py-0.5 bg-emerald-100 text-emerald-700 font-bold rounded">In Stock</span>
                                    </div>
                                    <h4 class="text-sm font-bold text-slate-800 line-clamp-2 leading-tight my-1">@prod.ProductName</h4>
                                </div>
                                <div class="mt-2 flex justify-between items-center pt-2 border-t border-slate-200/60">
                                    <span class="text-xs text-slate-500 font-medium">₹@prod.SalePrice / @prod.UnitName</span>
                                    <button class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-2 py-1 rounded shadow">
                                        + Add
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Quick Keyboard Actions Bar -->
            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap gap-2 text-xs text-slate-500">
                <span class="px-2 py-1 bg-slate-100 rounded border">💡 Tip: Click product to add to cart instantly</span>
            </div>
        </div>

        <!-- Right Section: Cart, Summary & Checkout (5 Cols) -->
        <div class="lg:col-span-5 bg-white p-4 rounded-xl shadow border border-slate-100 flex flex-col justify-between">
            <div>
                <!-- Customer Details Input -->
                <div class="grid grid-cols-2 gap-2 mb-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Customer Name</label>
                        <input type="text" @bind="CustomerName" class="w-full text-xs p-2 border border-slate-200 rounded focus:ring-1 focus:ring-indigo-500" placeholder="Walk-in Customer" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Mobile No.</label>
                        <input type="text" @bind="MobileNo" class="w-full text-xs p-2 border border-slate-200 rounded focus:ring-1 focus:ring-indigo-500" placeholder="10 digit mobile" />
                    </div>
                </div>

                <!-- Cart Items List -->
                <div class="cart-header flex justify-between items-center border-b pb-2 mb-2">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Current Cart (@CartItems.Count items)</span>
                    <button class="text-xs text-rose-600 hover:text-rose-800 font-semibold" @onclick="ClearCart">Clear All</button>
                </div>

                <div class="cart-items max-h-[260px] overflow-y-auto space-y-2 pr-1">
                    @if (CartItems.Count == 0)
                    {
                        <div class="text-center py-8 text-slate-400 text-xs">
                            <div class="text-3xl mb-1">🛒</div>
                            <span>Cart is empty. Select products from left to begin.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in CartItems)
                        {
                            <div class="flex items-center justify-between p-2 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                                <div class="flex-1 pr-2">
                                    <div class="font-bold text-slate-800">@item.ProductName</div>
                                    <div class="text-[10px] text-slate-500">₹@item.Rate x @item.Qty = <span class="font-bold text-slate-700">₹@item.TotalAmount</span></div>
                                </div>
                                <div class="flex items-center space-x-1">
                                    <button class="w-5 h-5 bg-slate-200 hover:bg-slate-300 font-bold rounded flex items-center justify-center text-slate-700"
                                            @onclick="() => UpdateQty(item, -1)">-</button>
                                    <span class="w-6 text-center font-bold">@item.Qty</span>
                                    <button class="w-5 h-5 bg-indigo-100 hover:bg-indigo-200 font-bold rounded flex items-center justify-center text-indigo-700"
                                            @onclick="() => UpdateQty(item, 1)">+</button>
                                    <button class="w-5 h-5 ml-1 text-rose-500 hover:text-rose-700 font-bold text-sm"
                                            @onclick="() => RemoveItem(item)">✕</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Total Calculation & Pay Action -->
            <div class="mt-4 border-t border-slate-200 pt-3 space-y-2">
                <div class="flex justify-between text-xs text-slate-600">
                    <span>Subtotal:</span>
                    <span class="font-bold text-slate-800">₹@Subtotal.ToString("F2")</span>
                </div>
                <div class="flex justify-between items-center text-xs text-slate-600">
                    <span>Discount (%):</span>
                    <input type="number" @bind="DiscountPercent" @bind:event="oninput" min="0" max="100" class="w-16 text-right text-xs p-1 border rounded" />
                </div>
                <div class="flex justify-between text-xs text-slate-600">
                    <span>Discount Amount:</span>
                    <span class="font-bold text-rose-600">- ₹@DiscountAmount.ToString("F2")</span>
                </div>
                <div class="flex justify-between items-center text-xs text-slate-600">
                    <span>Payment Method:</span>
                    <select @bind="PaymentMethod" class="text-xs p-1 border rounded font-semibold bg-slate-50">
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR Code</option>
                        <option value="Card">Card</option>
                        <option value="Credit">Credit / Account</option>
                    </select>
                </div>
                
                <div class="flex justify-between text-base font-extrabold text-slate-900 border-t pt-2 mt-2">
                    <span>Grand Total:</span>
                    <span class="text-indigo-600 font-mono text-lg">₹@GrandTotal.ToString("F2")</span>
                </div>

                <button class="w-full mt-2 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl shadow-lg transition transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed flex justify-center items-center"
                        disabled="@(CartItems.Count == 0 || IsProcessing)"
                        @onclick="ProcessCheckout">
                    @if (IsProcessing)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                        <span>Generating Bill...</span>
                    }
                    else
                    {
                        <span>💳 Complete & Print Bill (₹@GrandTotal.ToString("F2"))</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .pos-blazor-container {
        max-width: 100%;
        margin: 0 auto;
    }
</style>

@code {
    private string SearchQuery = "";
    private string CustomerName = "";
    private string MobileNo = "";
    private decimal DiscountPercent = 0;
    private string PaymentMethod = "Cash";
    private string BillNo = "GENERATING...";
    private bool IsLoading = true;
    private bool IsProcessing = false;
    private string? ToastMessage = null;
    private string ToastType = "success";

    private class LocalProductItem
    {
        public int ProductId { get; set; }
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public decimal SalePrice { get; set; }
        public string UnitName { get; set; } = "Pcs";
    }

    private class LocalCartItem
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Rate { get; set; }
        public int Qty { get; set; }
        public decimal TotalAmount => Rate * Qty;
    }

    private List<LocalProductItem> Catalog = new();
    private List<LocalCartItem> CartItems = new();

    private IEnumerable<LocalProductItem> FilteredProducts =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? Catalog
            : Catalog.Where(p => p.ProductName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                 p.ProductCode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    private decimal Subtotal => CartItems.Sum(x => x.TotalAmount);
    private decimal DiscountAmount => (Subtotal * DiscountPercent) / 100m;
    private decimal GrandTotal => Math.Max(0, Subtotal - DiscountAmount);

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        BillNo = BillingService.GetGenerateBillNo();
    }

    private async Task LoadProducts()
    {
        IsLoading = true;
        try
        {
            var rawList = await CachedProductService.GetCachedStockListAsync();
            Catalog = rawList.Select(r => new LocalProductItem
            {
                ProductId = GetDynamicProp(r, "ProductId", 0),
                ProductCode = GetDynamicProp(r, "ProductCode", "P-100"),
                ProductName = GetDynamicProp(r, "ProductName", "Item"),
                SalePrice = GetDynamicPropDecimal(r, "SalePrice", 100m),
                UnitName = GetDynamicProp(r, "UnitName", "Pcs")
            }).ToList();
        }
        catch (Exception ex)
        {
            ShowToast("Error loading catalog: " + ex.Message, "error");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddToCart(LocalProductItem prod)
    {
        var existing = CartItems.FirstOrDefault(c => c.ProductId == prod.ProductId);
        if (existing != null)
        {
            existing.Qty++;
        }
        else
        {
            CartItems.Add(new LocalCartItem
            {
                ProductId = prod.ProductId,
                ProductName = prod.ProductName,
                Rate = prod.SalePrice,
                Qty = 1
            });
        }
        ShowToast($"Added {prod.ProductName} to cart", "success");
    }

    private void UpdateQty(LocalCartItem item, int delta)
    {
        item.Qty += delta;
        if (item.Qty <= 0)
        {
            CartItems.Remove(item);
        }
    }

    private void RemoveItem(LocalCartItem item)
    {
        CartItems.Remove(item);
    }

    private void ClearCart()
    {
        CartItems.Clear();
        DiscountPercent = 0;
        ShowToast("Cart cleared", "success");
    }

    private async Task RefreshProducts()
    {
        CachedProductService.ClearStockCache();
        await LoadProducts();
        ShowToast("Product stock catalog refreshed", "success");
    }

    private async Task ProcessCheckout()
    {
        if (CartItems.Count == 0) return;

        IsProcessing = true;
        try
        {
            // Convert to CartModel list expected by BillingService
            var cartModelList = CartItems.Select(c => new CartModel
            {
                ProductId = c.ProductId,
                ProductName = c.ProductName,
                Rate = c.Rate,
                Quantity = c.Qty,
                Amount = c.TotalAmount
            }).ToList();

            var invoice = await BillingService.CreateInvoiceAsync(
                BillNo, cartModelList, CustomerName, MobileNo, DiscountPercent, PaymentMethod, 1, 1);

            ShowToast($"Bill #{BillNo} Generated Successfully!", "success");
            
            // Clear cart & regenerate Bill No
            CartItems.Clear();
            CustomerName = "";
            MobileNo = "";
            DiscountPercent = 0;
            BillNo = BillingService.GetGenerateBillNo();
        }
        catch (Exception ex)
        {
            ShowToast("Failed to process bill: " + ex.Message, "error");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void ShowToast(string message, string type)
    {
        ToastMessage = message;
        ToastType = type;
    }

    private string GetDynamicProp(object obj, string propName, string defaultVal)
    {
        try
        {
            var p = obj.GetType().GetProperty(propName);
            var val = p?.GetValue(obj, null)?.ToString();
            return string.IsNullOrEmpty(val) ? defaultVal : val;
        }
        catch { return defaultVal; }
    }

    private int GetDynamicProp(object obj, string propName, int defaultVal)
    {
        try
        {
            var p = obj.GetType().GetProperty(propName);
            var val = p?.GetValue(obj, null);
            return val != null ? Convert.ToInt32(val) : defaultVal;
        }
        catch { return defaultVal; }
    }

    private decimal GetDynamicPropDecimal(object obj, string propName, decimal defaultVal)
    {
        try
        {
            var p = obj.GetType().GetProperty(propName);
            var val = p?.GetValue(obj, null);
            return val != null ? Convert.ToDecimal(val) : defaultVal;
        }
        catch { return defaultVal; }
    }
}
